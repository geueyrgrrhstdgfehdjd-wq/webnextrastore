<%- include('../partials/header') %>
<div class="max-w-3xl mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6">ตั้งค่า UI</h1>
  <form action="/admin/settings" method="POST" class="card p-6 space-y-4">
    <div><label class="block text-sm mb-1">ชื่อร้าน</label><input type="text" name="shop_name" value="<%= settings.shop_name||'' %>" class="input"></div>
    <div><label class="block text-sm mb-1">คำอธิบาย</label><textarea name="shop_description" class="input" rows="2"><%= settings.shop_description||'' %></textarea></div>
    <div><label class="block text-sm mb-1">ประกาศ</label><input type="text" name="announcement" value="<%= settings.announcement||'' %>" class="input"></div>
    <div><label class="block text-sm mb-1">สถานะ</label><select name="shop_status" class="input"><option value="open" <%=settings.shop_status==='open'?'selected':''%>>เปิด</option><option value="closed" <%=settings.shop_status==='closed'?'selected':''%>>ปิด</option></select></div>
    <div class="grid grid-cols-2 gap-3">
      <div><label class="block text-sm mb-1">สีหลัก</label><input type="color" name="primary_color" value="<%= settings.primary_color||'#8b5cf6' %>" class="input h-10"></div>
      <div><label class="block text-sm mb-1">สีเน้น</label><input type="color" name="accent_color" value="<%= settings.accent_color||'#06b6d4' %>" class="input h-10"></div>
      <div><label class="block text-sm mb-1">พื้นหลัง</label><input type="color" name="bg_color" value="<%= settings.bg_color||'#0a0a14' %>" class="input h-10"></div>
      <div><label class="block text-sm mb-1">สีการ์ด</label><input type="color" name="card_color" value="<%= settings.card_color||'#14141f' %>" class="input h-10"></div>
    </div>
    <div><label class="block text-sm mb-1">LINE ID</label><input type="text" name="contact_line" value="<%= settings.contact_line||'' %>" class="input"></div>
    <div><label class="block text-sm mb-1">เบอร์ TrueMoney</label><input type="text" name="truemoney_phone" value="<%= settings.truemoney_phone||'' %>" class="input"></div>
    <button type="submit" class="btn-primary w-full justify-center">บันทึก</button>
  </form>
</div>
<%- include('../partials/footer') %>
